.claude/

# LaTeX build artifacts.
# main.bbl is NOT ignored: it ships inside the arXiv tarballs, because
# arXiv does not run BibTeX. It is a build input, not an artifact.
*.aux
*.log
*.out
*.toc
*.blg
*.fls
*.fdb_latexmk
*.synctex.gz

# Per-paper PDFs are published at the repo root, not beside the source
arxiv/main.pdf
self_awareness/main.pdf

# Stray file from an unrelated process; not part of this corpus
plan0.md

fleet/*.aux
fleet/*.log
fleet/*.out
fleet/*.toc
fleet/*.blg
fleet/main.pdf

singularity_edition/*.aux
singularity_edition/*.log
singularity_edition/*.out
singularity_edition/*.toc
singularity_edition/*.blg
singularity_edition/main.pdf
