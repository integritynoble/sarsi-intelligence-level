{
  "name": "AI-Level cumulative structure policy",
  "version": "0.3",
  "theory_basis": "Unified Intelligence Theory and the Artificial Intelligence Level v2.6",
  "general_rule": "No certified capability level may skip required lower capabilities.",
  "objects": {
    "C": {
      "type": "hard_capability",
      "cumulative": true,
      "levels": [
        "C0",
        "C1",
        "C2",
        "C3",
        "C4",
        "C5",
        "C6",
        "CΩ"
      ],
      "retention": "all prior C levels"
    },
    "I": {
      "type": "hard_capability",
      "cumulative": true,
      "levels": [
        "I0",
        "I1",
        "I2",
        "I3",
        "I4",
        "I5",
        "IΩ"
      ],
      "retention": "all prior I levels plus independent M prerequisite where specified"
    },
    "M": {
      "type": "hard_supporting_capability",
      "cumulative": true,
      "levels": [
        "M0",
        "M1",
        "M2",
        "M3",
        "M4",
        "M5",
        "MΩ"
      ],
      "retention": "all prior M levels"
    },
    "O": {
      "type": "hard_capability",
      "cumulative": true,
      "levels": [
        "O0",
        "O1",
        "O2",
        "O3",
        "O4",
        "O5",
        "OΩ"
      ],
      "retention": "all prior O levels"
    },
    "SA": {
      "type": "hard_capability_from_SA1",
      "cumulative": true,
      "baseline_exception": "SA0 is a negative/default category and is not retained",
      "levels": [
        "SA0",
        "SA1",
        "SA2",
        "SA3",
        "SA4",
        "SA5",
        "SA6",
        "SAΩ"
      ],
      "retention": "SAk (k>=2) retains SA1..SA(k-1)"
    },
    "GP": {
      "type": "cumulative_diagnostic",
      "cumulative": true,
      "parent_coordinate": "C",
      "parent_domain": "GUI/screen",
      "levels": [
        "GP0",
        "GP1",
        "GP2",
        "GP3",
        "GP4",
        "GP5"
      ],
      "retention": "all prior GP levels",
      "no_promotion": [
        "C^GUI",
        "C",
        "U"
      ]
    },
    "C^GUI": {
      "type": "C_domain_witness",
      "cumulative": "inherits_C",
      "retention": "K_C,<k",
      "gp_prerequisite": "form-specific optional blocker; never promotes C"
    },
    "DI": {
      "type": "cumulative_frontier",
      "cumulative": true,
      "retention": "all lower T bands at same H ceiling and reliability p",
      "frontier_law": "DF(h,p)=max{T_k:min_{j<=k}S_net(T_j,H<=h)>=p}"
    },
    "T": {
      "type": "ordered_axis",
      "cumulative": false,
      "levels": [
        "T0",
        "T1",
        "T2",
        "T3",
        "T4",
        "T5",
        "T6",
        "TΩ"
      ],
      "note": "task structural class; lower-band retention belongs to DI frontier, not T item certification"
    },
    "H": {
      "type": "ordered_axis",
      "cumulative": false,
      "levels": [
        "H0",
        "H1",
        "H2",
        "H3",
        "H4",
        "H5"
      ],
      "note": "human cognitive intervention class; lower is less assistance"
    },
    "HG": {
      "type": "cumulative_engineering",
      "cumulative": true,
      "levels": [
        "HG0",
        "HG1",
        "HG2",
        "HG3",
        "HG4",
        "HG5",
        "HG6",
        "HGΩ"
      ],
      "retention": "strict mechanism superset; all previous rungs retained",
      "not_intelligence": true
    },
    "U": {
      "type": "hard_gated_integration",
      "cumulative": true,
      "levels": [
        "U0",
        "U1",
        "U2",
        "U3",
        "U4",
        "U5",
        "U6",
        "UΩ"
      ],
      "retention": "all prior U levels plus current coordinate/delegation gates"
    },
    "p": {
      "type": "reliability_condition",
      "cumulative": false,
      "note": "threshold/uncertainty condition, not an intelligence ladder"
    }
  }
}
