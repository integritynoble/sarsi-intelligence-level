{
  "agent_id": "example-agent",
  "theta_components": [
    {
      "id": "debug_policy",
      "role": "debugging/planning procedure",
      "interface": "agent.skills.debug_policy",
      "write_scope": [
        "/agent/skills/debug_policy/"
      ],
      "activation": "loaded for debugging tasks",
      "snapshot": "content hash + versioned artifact",
      "restore": "runner restores prior version"
    },
    {
      "id": "retrieval_policy",
      "role": "retrieval/reranking procedure",
      "interface": "agent.retrieval.policy",
      "write_scope": [
        "/agent/retrieval/policy/"
      ],
      "activation": "invoked on every retrieval decision",
      "snapshot": "serialized policy artifact",
      "restore": "runner restores serialized prior artifact"
    }
  ]
}