{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI-Level Harmonized Canonical Method Record",
  "type": "object",
  "required": [
    "form_id",
    "coordinate",
    "level",
    "canonical_method",
    "protocol_style_version",
    "capability_being_tested",
    "experimental_intervention",
    "procedure",
    "controls_or_ablations",
    "primary_metrics",
    "certification_gate",
    "required_lower_levels",
    "resource_envelope",
    "binding_status",
    "dataset_version"
