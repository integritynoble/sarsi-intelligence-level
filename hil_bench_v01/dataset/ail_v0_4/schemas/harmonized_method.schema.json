      "type": "string"
    },
    "coordinate": {
      "type": "string"
    },
    "level": {
      "type": "string"
    },
    "canonical_method": {
      "type": "string"
    },
    "protocol_style_version": "AI-Level-Method-1.0",
    "capability_being_tested": {
      "type": "string"
    },
    "experimental_intervention": {
      "type": "string"
    },
    "procedure": {
