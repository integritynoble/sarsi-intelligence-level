{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-level-bench.dev/schemas/memory_manifest.schema.json",
  "title": "AI-Level Bench Memory Manifest",
  "type": "object",
  "required": [
    "manifest_id",
    "stores",
    "retrieval",
    "consolidation",
    "management",
    "snapshot",
    "restart",
    "phi"
  ],
  "properties": {
    "manifest_id": {
      "type": "string"
    },
    "stores": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "retrieval": {
      "type": "object"
    },
    "consolidation": {
      "type": "object"
    },
    "representation": {
      "type": "object"
    },
    "management": {
      "type": "object"
    },
    "forgetting_demotion": {
      "type": "object"
    },
    "snapshot": {
      "type": "object"
    },
    "restart": {
      "type": "object"
    },
    "phi": {
      "type": "object",
      "required": [
        "id",
        "version",
        "active"
      ]
    },
    "memory_write_set": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}