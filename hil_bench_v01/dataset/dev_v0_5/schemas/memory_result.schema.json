{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hil-bench.dev/schemas/memory_result.schema.json",
  "title": "HIL-Bench M-Bench result record",
  "type": "object",
  "required": [
    "run_id",
    "form_id",
    "level",
    "benchmark_version",
    "memory_manifest_hash",
    "difficulty_vector",
    "metrics",
    "retention",
    "verifier",
    "promotion"
  ],
  "properties": {
    "run_id": {
      "type": "string"
    },
    "form_id": {
      "type": "string"
    },
    "level": {
      "enum": [
        "M0",
        "M1",
        "M2",
        "M3",
        "M4",
        "M5",
        "MΩ"
      ]
    },
    "benchmark_version": {
      "const": "0.5"
    },
    "model_hash": {
      "type": "string"
    },
    "harness_hash": {
      "type": "string"
    },
    "memory_manifest_hash": {
      "type": "string"
    },
    "difficulty_vector": {
      "type": "object"
    },
    "metrics": {
      "type": "object"
    },
    "thresholds": {
      "type": "object"
    },
    "uncertainty_rule": {
      "type": "object"
    },
    "control_result": {
      "type": "object"
    },
    "retention": {
      "type": "object"
    },
    "verifier": {
      "type": "object"
    },
    "promotion": {
      "type": "object"
    }
  },
  "additionalProperties": true
}