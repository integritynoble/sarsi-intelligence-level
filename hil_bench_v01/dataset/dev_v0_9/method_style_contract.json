{
  "name": "HIL Canonical Method Style Contract",
  "version": "HIL-Method-1.0",
  "fields": {
    "capability_being_tested": "one new capability/measurement property isolated at this level or band",
    "canonical_method": "stable named experiment",
    "experimental_intervention": "what the evaluator changes or withholds",
    "hidden_or_grounded_state": "truth outside candidate write set",
    "procedure": "ordered reproducible experimental steps",
    "controls_or_ablations": "causal/boundary controls preventing shortcut explanations",
    "primary_metrics": "externally scored outcomes",
    "certification_gate": "preregistered conjunctive acceptance rule",
    "required_lower_levels": "cumulative retention set where applicable",
    "resource_envelope": "tokens/calls/tools/time/state/authority/human assistance",
    "binding_status": "bound, development-bound, or specification-only"
  },
  "object_semantics": {
    "C/I/O/SA": "intelligence coordinates/families",
    "M": "diagnostic support coordinate",
    "T": "task difficulty band",
    "H": "human intervention band",
    "DI": "derived T×H surface",
    "HG": "engineering conformance rung, not intelligence",
    "U": "gated integration level, not arithmetic average"
  }
}