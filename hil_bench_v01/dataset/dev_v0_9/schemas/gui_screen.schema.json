{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HIL-Bench GUI/screen development form v0.7",
  "type": "object",
  "required": [
    "form_id",
    "coordinate",
    "domain",
    "record_type",
    "canonical_method",
    "development_only",
    "dataset_version",
    "binding_status"
  ],
  "properties": {
    "form_id": {
      "type": "string"
    },
    "coordinate": {
      "const": "C"
    },
    "domain": {
      "const": "GUI/screen"
    },
    "record_type": {
      "enum": [
        "gui_perception_diagnostic",
        "c_gui_witness"
      ]
    },
    "diagnostic_subscale": {
      "type": "string"
    },
    "gp_level": {
      "type": "string"
    },
    "gui_level_label": {
      "type": "string"
    },
    "level": {
      "type": "string"
    },
    "canonical_method": {
      "type": "string"
    },
    "development_only": {
      "const": true
    },
    "dataset_version": {
      "const": "0.7"
    },
    "binding_status": {
      "enum": [
        "development-bound",
        "specification-only"
      ]
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "oracle_screen_graph": {
      "type": "string"
    },
    "oracle_screen_graphs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "prompt": {
      "type": "string"
    },
    "verifier": {
      "type": "object"
    },
    "controls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "resource_envelope": {
      "type": "object"
    },
    "human_intervention": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "gui_perception_diagnostic"
          }
        }
      },
      "then": {
        "required": [
          "gp_level"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "c_gui_witness"
          }
        }
      },
      "then": {
        "required": [
          "gui_level_label",
          "level"
        ]
      }
    }
  ]
}