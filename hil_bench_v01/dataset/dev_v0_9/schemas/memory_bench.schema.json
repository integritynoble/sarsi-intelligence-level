{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HIL-Bench M-Bench public development form",
  "type": "object",
  "required": [
    "form_id",
    "coordinate",
    "level",
    "canonical_method",
    "development_only"
  ],
  "properties": {
    "form_id": {
      "type": "string"
    },
    "coordinate": {
      "const": "M"
    },
    "level": {
      "enum": [
        "M0",
        "M1",
        "M2",
        "M3",
        "M4",
        "M5",
        "MΩ"
      ]
    },
    "canonical_method": {
      "enum": [
        "M0-EPH",
        "M1-RST",
        "M2-PROV",
        "M3-CONSOL",
        "M4-MGMT",
        "M5-LONG",
        "MOMEGA-EVOLVE"
      ]
    },
    "development_only": {
      "const": true
    },
    "retention": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
