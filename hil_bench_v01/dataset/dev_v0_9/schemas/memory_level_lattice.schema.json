{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hil-bench.dev/schemas/memory_level_lattice.schema.json",
  "title": "HIL-Bench cumulative Memory Capability lattice",
  "type": "object",
  "required": [
    "version",
    "coordinate",
    "ordering",
    "levels"
  ],
  "properties": {
    "version": {
      "const": "0.6"
    },
    "coordinate": {
      "const": "M"
    },
    "ordering": {
      "const": [
        "M0",
        "M1",
        "M2",
        "M3",
        "M4",
        "M5",
        "MΩ"
      ]
    },
    "levels": {
      "type": "object"
    }
  },
  "additionalProperties": true
}